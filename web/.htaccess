# Ghani Group Rental — Apache
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # تمرير ترويسة Authorization إلى PHP
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # منع الوصول للمجلدات والملفات الداخلية
  RewriteRule ^(app|config|storage|docs)(/|$) - [F,L]
  RewriteRule ^install/(seed|schema\.sql) - [F,L]
  RewriteRule ^assets/pages/.+\.html$ - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(sql|log|md|lock|json|ini|sh|bak)$ - [F,L]

  # كل شيء غير موجود فعلياً → index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(?!sw\.js$).*\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

LimitRequestBody 26214400
