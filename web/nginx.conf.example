# Ghani Group Rental — Nginx (with optional load balancing of PHP-FPM/web nodes)
#
# upstream لعدة سيرفرات تطبيق (توزيع الأحمال على مستوى الويب):
# upstream gg_app { least_conn; server 10.0.0.11:9000; server 10.0.0.12:9000; keepalive 16; }

limit_req_zone $binary_remote_addr zone=gg_api:10m rate=20r/s;

server {
    listen 80;
    server_name rental.example.com;
    root /var/www/ghani-rental;
    index index.php;
    client_max_body_size 25m;
    server_tokens off;

    # ملفات داخلية
    location ~ ^/(app|config|storage|docs|install/seed)/ { deny all; return 404; }
    location ~ /\.(?!well-known) { deny all; }
    location ~* \.(sql|log|md|lock|json|ini|sh|bak)$ { deny all; }

    # لا PHP داخل مجلد الرفع
    location ^~ /uploads/ {
        location ~ \.php$ { deny all; }
        add_header X-Content-Type-Options nosniff;
        expires 30d;
        try_files $uri =404;
    }

    location /assets/ { expires 30d; add_header Cache-Control "public"; try_files $uri =404; }

    location /api/ {
        limit_req zone=gg_api burst=40 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location / { try_files $uri $uri/ /index.php?$query_string; }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;   # أو gg_app
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
