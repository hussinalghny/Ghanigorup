# صور المعدات — لا تنفيذ لأي سكربت داخل هذا المجلد
# (بدون أوامر Options لأن كثيراً من الاستضافات تمنعها داخل .htaccess وتسبب خطأ 500 لكل الصور)
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options nosniff
  Header set Cache-Control "public, max-age=2592000"
</IfModule>
